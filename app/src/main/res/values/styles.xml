<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RetroAmp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/winamp_accent</item>
        <item name="colorPrimaryVariant">@color/winamp_dark_green</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="android:statusBarColor">#121318</item>
        <item name="android:navigationBarColor">#121318</item>
        <item name="android:windowBackground">#181920</item>
        <item name="materialButtonStyle">@style/RetroMaterialButton</item>
    </style>

    <style name="RetroMaterialButton" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="cornerRadius">3dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>

